OPENROUTER_API_KEY=your-key-here
# Optional: pin a specific model. Default is the openrouter/free router,
# which always resolves to an available free model and filters for tool
# calling. Individual :free slugs rotate and can start returning 404
# ("paid version available now"), so only pin one if you know it's live.
# Check current free slugs at https://openrouter.ai/models?q=free
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
# Set to 0 to silence tool-call tracing in the CLI.
# DEBUG_TOOLS=1
